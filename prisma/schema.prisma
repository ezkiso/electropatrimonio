// Esquema de base de datos (SQLite para desarrollo)
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Solicitudes de contacto recibidas desde el formulario web
model Lead {
  id          String   @id @default(uuid())
  name        String
  email       String
  phone       String
  serviceType String
  message     String
  createdAt   DateTime @default(now())
}
